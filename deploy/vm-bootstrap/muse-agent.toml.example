[vm]
id = "{{VM_ID}}"
token = "{{CLUSTER_TOKEN}}"

[server]
host = "127.0.0.1"
port = 11436

[inference]
socket_path = "/run/hatch/sandbox/space-inference.sock"
media_socket_path = "/run/hatch/sandbox/space-media.sock"
max_frame_size_mb = 64

[supervisor]
enabled = true
check_interval_secs = 5
base_dir = "/home/hatch/workspace/agent"
frpc_bin = "/home/hatch/workspace/agent/bin/frpc"
frpc_config = "/home/hatch/workspace/agent/config/frpc.toml"

# Active-standby file server. auth_user/auth_salt/auth_hash MUST be byte-identical
# on every worker: failover logs the same user in against whichever node answers.
# Placeholder (all-zero) values cannot accept any password and report storage=false.
[file_manager]
enabled = true
host = "127.0.0.1"
port = 8080
root_dir = "/home/hatch/workspace/public"
auth_user = "{{AUTH_USER}}"
auth_salt = "{{AUTH_SALT}}"
auth_hash = "{{AUTH_HASH}}"

# Sync engine: VM-01 is the master, every other node mirrors it as a replica.
[sync]
enabled = true
role = "{{SYNC_ROLE}}"
sync_dir = "/home/hatch/workspace/public"
master_url = "https://files.yourdomain.com"
auth_token = "{{CLUSTER_TOKEN}}"
interval_secs = 15

# Account allowance sampled from the platform's own subscription tool. The
# sandbox sockets expose no credit balance; this tool does report the weekly
# limit, its reset time, and any purchased tokens left.
[quota]
enabled = true
status_bin = "/opt/hatch/bin/subscription-status"
interval_secs = 60
timeout_secs = 30
