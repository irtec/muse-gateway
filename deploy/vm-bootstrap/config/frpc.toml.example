serverAddr = "YOUR_EDGE_IP"
serverPort = 7000
auth.method = "token"
auth.token = "YOUR_FRP_SECRET_TOKEN"
log.to = "/tmp/frpc.log"
log.level = "info"
log.maxDays = 3

[[proxies]]
name = "ssh"
type = "tcp"
localIP = "127.0.0.1"
localPort = 22
remotePort = 2221

[[proxies]]
name = "muse-ai-vm1"
type = "tcp"
localIP = "127.0.0.1"
localPort = 11436
remotePort = 18081

[[proxies]]
name = "file-server-vm1"
type = "http"
localIP = "127.0.0.1"
localPort = 8080
customDomains = ["files.yourdomain.com"]

[[proxies]]
name = "file-server-direct-vm1"
type = "tcp"
localIP = "127.0.0.1"
localPort = 8080
remotePort = 18091
